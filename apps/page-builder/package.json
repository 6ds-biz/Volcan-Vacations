{
  "name": "6ds-web-builder",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "npm run assets && next dev -p 3002",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "next lint",
    "build": "npm run assets && next build",
    "start": "next start -p 3002",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs"
  },
  "dependencies": {
    "@6ds/page-builder": "file:../../packages/page-builder",
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.2",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.4",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.24",
    "playwright": "1.58.2"
  },
  "overrides": {"postcss": "8.5.23", "sharp": "0.35.3"}
}
